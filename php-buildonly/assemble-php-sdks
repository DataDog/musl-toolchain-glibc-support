#!/bin/sh
set -eu

sdk_root="${PHP_SDK_ROOT:-/opt/php}"
debug_stack_edit='s@^#define ZEND_CHECK_STACK_LIMIT 1$@/* #undef ZEND_CHECK_STACK_LIMIT */@'

break_link()
{
    file="$1"
    cp -p "${file}" "${file}.new"
    mv "${file}.new" "${file}"
}

rewrite_debug_metadata()
{
    file="$1"

    sed -i \
        -e "/^#define CONFIGURE_COMMAND / s@\"\$@ '--enable-debug'\"@" \
        -e "/^configure_options=/ s@\"\$@ '--enable-debug'\"@" \
        -e 's@/no-debug-non-zts-@/debug-non-zts-@g' \
        "${file}"
}

# The official images are ZTS builds. Derive the NTS release SDK by undoing
# their ZTS options. Each edit is a no-op for versions that lack its line.
make_nts()
{
    prefix="$1"
    zts_php_config_h="$2"
    php_config_h="${prefix}/include/php/main/php_config.h"
    build_defs_h="${prefix}/include/php/main/build-defs.h"
    php_config="${prefix}/bin/php-config"

    # Zend signals are on by default since PHP 7.1. Restore them only where
    # the ZTS build disabled them explicitly.
    nts_signals_edit=
    zts_signals_edit=
    if grep -q "'--disable-zend-signals'" "${build_defs_h}"; then
        nts_signals_edit='s@^/\* #undef ZEND_SIGNALS \*/$@#define ZEND_SIGNALS 1@'
        zts_signals_edit='s@^#define ZEND_SIGNALS 1$@/* #undef ZEND_SIGNALS */@'
    fi
    sed -i \
        -e 's@^#define ZTS 1$@/* #undef ZTS */@' \
        -e 's@^#define PTHREADS 1$@/* #undef PTHREADS */@' \
        -e 's@^#define ZEND_MAX_EXECUTION_TIMERS 1$@/* #undef ZEND_MAX_EXECUTION_TIMERS */@' \
        -e "${nts_signals_edit}" \
        "${php_config_h}"
    # Redoing the edits must give back the official header.
    sed \
        -e 's@^/\* #undef ZTS \*/$@#define ZTS 1@' \
        -e 's@^/\* #undef PTHREADS \*/$@#define PTHREADS 1@' \
        -e 's@^/\* #undef ZEND_MAX_EXECUTION_TIMERS \*/$@#define ZEND_MAX_EXECUTION_TIMERS 1@' \
        -e "${zts_signals_edit}" \
        "${php_config_h}" | cmp - "${zts_php_config_h}"

    sed -i \
        -e "s@ '--enable-zts'@@" \
        -e "s@ '--enable-maintainer-zts'@@" \
        -e "s@ '--disable-zend-signals'@@" \
        -e "s@ '--enable-zend-max-execution-timers'@@" \
        -e 's@/no-debug-zts-@/no-debug-non-zts-@g' \
        "${build_defs_h}" "${php_config}"
    # ZTS adds the pthread library ahead of the extension libraries.
    sed -i '/^libs=/ s@ -lpthread@@' "${php_config}"
    # "! grep" would not stop "set -e".
    if grep -q -e "'--enable-zts'" -e "'--enable-maintainer-zts'" \
        -e 'no-debug-zts-' "${build_defs_h}" "${php_config}"; then
        echo "failed to derive NTS metadata in ${prefix}" >&2
        exit 1
    fi
}

make_variant()
{
    version="$1"
    variant="$2"
    release_prefix="${sdk_root}/${version}"
    prefix="${sdk_root}/${version}-${variant}"
    php_config_h="${prefix}/include/php/main/php_config.h"
    build_defs_h="${prefix}/include/php/main/build-defs.h"

    mkdir -p "${prefix}/include" "${prefix}/bin" "${prefix}/lib/php"
    cp -al "${release_prefix}/include/php" "${prefix}/include/php"
    cp -p "${release_prefix}/bin/php-config" "${prefix}/bin/php-config"
    ln -s "${release_prefix}/bin/phpize" "${prefix}/bin/phpize"
    ln -s "${release_prefix}/lib/php/build" "${prefix}/lib/php/build"

    # These are the only two headers generated differently by PHP's
    # release, debug, and ZTS configurations. Break their hard links before
    # changing them so the common header payload remains shared.
    break_link "${php_config_h}"
    break_link "${build_defs_h}"
    sed -i "s|^prefix=.*|prefix='${prefix}'|" \
        "${prefix}/bin/php-config"

    case "${variant}" in
        debug)
            sed -i \
                -e 's/^#define ZEND_DEBUG 0$/#define ZEND_DEBUG 1/' \
                "${php_config_h}"

            case "${version}" in
                7.0|7.1|7.2|7.3)
                    sed -i \
                        's/^#define PHP_BUILD_DEBUG ""$/#define PHP_BUILD_DEBUG " -Wall"/' \
                        "${build_defs_h}"
                    ;;
                8.3)
                    sed -i "${debug_stack_edit}" "${php_config_h}"
                    ;;
            esac

            rewrite_debug_metadata "${build_defs_h}"
            rewrite_debug_metadata "${prefix}/bin/php-config"
            ;;
        release-zts)
            # Made before make_nts runs, so it keeps the official ZTS files.
            ;;
        *)
            echo "unknown PHP SDK variant: ${variant}" >&2
            exit 1
            ;;
    esac
}

for spec in \
    7.0:70 7.1:71 7.2:72 7.3:73 7.4:74 \
    8.0:80 8.1:81 8.2:82 8.3:83 8.4:84 8.5:85 8.6:86
do
    version="${spec%%:*}"
    key="${spec#*:}"
    official="/mnt/php${key}"
    release_prefix="${sdk_root}/${version}"

    mkdir -p \
        "${release_prefix}/include" \
        "${release_prefix}/bin" \
        "${release_prefix}/lib/php"

    # Each SDK is sourced from its matching official ZTS PHP image.
    cp -a "${official}/include/php" "${release_prefix}/include/php"
    cp -p \
        "${official}/bin/phpize" \
        "${official}/bin/php-config" \
        "${release_prefix}/bin/"
    cp -a \
        "${official}/lib/php/build" \
        "${release_prefix}/lib/php/build"

    # Keep Clang's static runtime archives when phpize derives linker flags.
    # PHP 8.6 bundles libtool 2.5.
    case "${version}" in
        8.6) libtool_patch=/tmp/libtool-2.5-clang-rt-static-archives.patch ;;
        *) libtool_patch=/tmp/libtool-clang-rt-static-archives.patch ;;
    esac
    patch -d "${release_prefix}/lib/php" -p1 < "${libtool_patch}"

    # Avoid a false UBSan null-member diagnostic in PHP 7.0 headers.
    if [ "${version}" = "7.0" ]; then
        patch -d "${release_prefix}/include/php" -p1 \
            < /tmp/php-7.0-builtin-offsetof.patch
    fi

    sed -i "s|^prefix=.*|prefix='${release_prefix}'|" \
        "${release_prefix}/bin/phpize" \
        "${release_prefix}/bin/php-config"

    make_variant "${version}" release-zts
    make_nts "${release_prefix}" "${official}/include/php/main/php_config.h"
    make_variant "${version}" debug
done
